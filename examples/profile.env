# Review and merge these values into the PINNED Mia checkout's .env.
# Keep its other defaults. Replace every REPLACE_ value with your local value.
# Each rank's fabric interface, HCA and IPv4 RoCE-v2 GID must be verified.
HEAD_IP=REPLACE_HEAD_FABRIC_IPV4
WORKER_IP=REPLACE_WORKER_FABRIC_IPV4
WORKER_USER=REPLACE_WORKER_USERNAME
WORKER_HOME=REPLACE_ABSOLUTE_WORKER_HOME
WORKER_SSH=$WORKER_USER@$WORKER_IP
HEAD_CX7_IF=REPLACE_HEAD_ETHERNET_INTERFACE
WORKER_CX7_IF=REPLACE_WORKER_ETHERNET_INTERFACE
HEAD_CX7_IB=REPLACE_HEAD_RDMA_HCA
WORKER_CX7_IB=REPLACE_WORKER_RDMA_HCA
HEAD_GID=REPLACE_HEAD_IPV4_ROCE_V2_GID_INDEX
WORKER_GID=REPLACE_WORKER_IPV4_ROCE_V2_GID_INDEX

MODEL_HOST=$HOME/dsv41-data/model
ENGRAM_DIR=$HOME/dsv41-data/native-engram
ENGRAM_SRC=$HOME/dsv41-data/slim-engram
HEAD_ENGRAM_BIND=$HOME/dsv41-data/slim-engram
WORKER_MODEL_DIR=$WORKER_HOME/dsv41-data/model
WORKER_ENGRAM_DIR=$WORKER_HOME/dsv41-data/slim-engram
WORKER_MODEL_BIND=$WORKER_MODEL_DIR
WORKER_ENGRAM_BIND=$WORKER_ENGRAM_DIR
WEIGHT_SYNC=rsync
NFS_SHARE=0
AUTO_DOWNLOAD=0
EXPECTED_SHARDS=39

IMAGE=dsv41-flash-exl3:stock-pinned
SERVED_MODEL_NAME=DeepSeek-v4.1-Flash-EXL3
PORT=8888
MASTER_PORT=29521
TP=2
NNODES=2
SPEC_METHOD=dspark
DSPARK_TOKENS=3
ENFORCE_EAGER=0
LANGUAGE_MODEL_ONLY=1
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2048
LONG_PREFILL_TOKEN_THRESHOLD=1792
GPU_MEM_UTIL=0.88
KV_CACHE_MEMORY_BYTES=1073741824
KV_BLOCK_SIZE=64
DSV41_CACHE_GIB=0
DSV41_RESIDENT_SCALES=0
DSV41_IO_THREADS=32
DSV41_DROP_PAGE_CACHE=1
DSV41_MEM_GUARD=0

CACHE_ROOT=$HOME/.cache/dsv41-stock-v1
WORKER_VLLM_CACHE=$WORKER_HOME/.cache/dsv41-stock-v1
# Keep ABLIT, ABLIT_ALPHA, ABLIT_PARAMS and EXL3_OVERLAY_HOST out of .env.
# Supply them explicitly for a hook launch as shown in the guide.
